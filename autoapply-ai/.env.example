# ==============================================================================
# AutoApply AI - Native Windows Environment Configuration
# ==============================================================================

# Flask Server
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
APP_HOST=0.0.0.0
APP_PORT=5050
FRONTEND_URL=http://localhost:5050

# Database
# Default: SQLite (runs natively on Windows with zero setup)
DATABASE_URL=sqlite:///autoapply.db
# Optional: PostgreSQL (if running local PostgreSQL service on Windows)
# DATABASE_URL=postgresql://autoapply:autoapply_pass@localhost:5432/autoapply_db

# Background Tasks & Worker
# When Redis/Celery is not running, AutoApply AI automatically runs tasks in native Windows daemon threads.
# If you run Redis on Windows (or Redis on WSL), configure below:
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES=86400

# Fernet Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=change-this-fernet-key-generated-with-fernet-generate-key

# AI Integration - Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth (for Gmail application confirmation tracking)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5050/api/gmail/callback

# Storage & Upload Folders (relative to backend directory)
UPLOAD_FOLDER=uploads
RESUME_FOLDER=uploads/resumes
SCREENSHOT_FOLDER=uploads/screenshots
BROWSER_PROFILE_DIR=browser_profiles
MAX_CONTENT_LENGTH=16777216

# Rate Limiting & Safety
MAX_APPLICATIONS_PER_DAY=50
REQUIRE_USER_APPROVAL=true

# Playwright & Browser Automation
# Set to false to see the Chrome browser fill forms live on your Windows desktop
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT=30000
