# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# Database
DATABASE_URL=postgresql://autoapply:autoapply_pass@localhost:5432/autoapply_db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRES=86400

# Fernet encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=change-this-fernet-key-generated-with-fernet-generate-key

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth (for Gmail confirmation tracking)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback

# Upload paths
UPLOAD_FOLDER=uploads
RESUME_FOLDER=uploads/resumes
SCREENSHOT_FOLDER=uploads/screenshots
MAX_CONTENT_LENGTH=16777216

# Rate limiting
MAX_APPLICATIONS_PER_DAY=50

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# App
APP_HOST=0.0.0.0
APP_PORT=5000
FRONTEND_URL=http://localhost:3000
